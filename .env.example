PORT=8787
PREDGE_API=https://api.predge.io
# Pilot key for check_purchase (free inside the pilot window). Never commit it.
# Without it, check_purchase runs a clearly labelled offline sample check (unsigned).
PREDGE_KEY=
# Purchase journal: DynamoDB table (created on-demand) when AWS credentials are present, else in-memory.
# KEPT_STORE=auto|dynamodb|memory
KEPT_TABLE=kept-purchases
KEPT_HOUSEHOLD=household-demo
# Demo agent on Amazon Bedrock (standard AWS SDK credential chain, e.g. AWS_PROFILE=predge)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# Polly voice for the demo narration
POLLY_VOICE=Joanna
# Not used in the Kept story; keep off.
# ENABLE_MARKET_TOOLS=1
# MCP_STATELESS=1
# MCP_AUTH_TOKEN=
