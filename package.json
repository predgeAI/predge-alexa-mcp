{
  "name": "predge-alexa-mcp",
  "version": "0.1.0",
  "description": "Kept: did Alexa get what you paid for? A self-hosted MCP server that records every purchase an agent makes, checks the merchant confirmation against what was promised, and returns a signed verdict that verifies offline. Simulated Alexa+ demo on Amazon Bedrock, DynamoDB and Polly.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "demo-check": "tsx scripts/demo-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1156.0",
    "@aws-sdk/client-dynamodb": "^3.1156.0",
    "@aws-sdk/client-polly": "^3.1156.0",
    "@aws-sdk/lib-dynamodb": "^3.1156.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
